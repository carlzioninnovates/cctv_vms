# Generated by the agent. Do not edit by hand: the cloud sends the full proxy list.
serverAddr = "{{ frps.host }}"
serverPort = {{ frps.port }}
loginFailExit = false                  # keep retrying through outages

auth.method = "token"
auth.token = "{{ frps.token }}"
# Checked by the frps plugin on Login and NewProxy (revocation + port ownership)
metadatas.agent_uid = "{{ agent_uid }}"
metadatas.secret = "{{ frps.tunnel_secret }}"

transport.protocol = "tcp"
transport.tls.enable = true
transport.tls.certFile = "{{ conf_dir }}/agent.crt"
transport.tls.keyFile = "{{ conf_dir }}/agent.key"
transport.tls.trustedCaFile = "{{ conf_dir }}/ca.crt"
transport.heartbeatInterval = 15
transport.heartbeatTimeout = 45
transport.poolCount = 2

# Local admin API, used by `frpc reload` when the proxy list changes
webServer.addr = "127.0.0.1"
webServer.port = 7400
{% for p in proxies %}
[[proxies]]
name = "{{ agent_uid[:8] }}-{{ p.lan_host }}-{{ p.lan_port }}"
type = "tcp"
localIP = "{{ p.lan_host }}"
localPort = {{ p.lan_port }}
remotePort = {{ p.remote_port }}
transport.useCompression = {{ 'false' if p.kind == 'rtsp' else 'true' }}
{% endfor %}
